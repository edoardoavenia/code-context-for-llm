{
  "max_file_size_kb": 10000,
  "exclude": {
    "extensions": [
      ".pyc",
      ".log",
      ".cache",
      ".tmp"
    ],
    "files": [
      ".env"
    ],
    "directories": [
      "__pycache__",
      ".git",
      "venv",
      ".pytest_cache",
      "node_modules",
      "dist",
      "build"
    ],
    "max_depth": 20,
    "max_files": 300
  }
}
